#!/usr/bin/env bash
# Entry point for hexapod project commands (host side).
# Dispatches to per-process scripts under scripts/.
#   ./hexa sim [args...]   -> drop into the ROS2 Jazzy sim container
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<EOF
Usage: ./hexa <command> [args...]

Commands:
  sim <up|down|refresh|restart|logs|build|shell|status|cmd...>
                              Sim-container lifecycle via docker compose. The sim stack
                              runs as the container's PID 1, so:
                                up [--cpp] [--clean]  bring it up detached
                                down                  stop and remove it
                                refresh [args...]     rebuild + restart the running stack
                                restart               restart without rebuild (apply config edits)
                                logs [-f]             show / stream logs
                                build [args...]       colcon build (ephemeral container)
                                shell                 interactive ROS2-sourced shell
                                status                compose ps (+ node list when up)
                                <cmd...>              one-off command, e.g. 'ros2 topic list'
                              --cpp sets HEXA_CPP=1 so the launch files default to the C++
                              ports (hexa_kinematics_cpp / hexa_gait_cpp); --clean rebuilds
                              the image. See 'hexa sim --help'.
  pico <up|down|logs|status>
                              Firmware-in-sim: the Pi Pico firmware brain walks the Gazebo
                              hexapod (sim + joy + firmware bridge). 'up' builds
                              hexa_pico_bridge then brings the pico service up detached;
                              mutually exclusive with the sim stack.
  deploy <subcommand> [args]  Cross-build + ship the production image to the robot.
                              Subcommands: build, push <host>. Run with no
                              subcommand for the full list.
  robot [-H user@host] <subcommand> [args]
                              Operate the running robot container. Subcommands: up, down,
                              restart, status, logs [-f], shell. 'up' boots the container
                              cold then energizes (relay on) — teleop is part of the launch,
                              so the robot is drivable once 'up' finishes; 'down' is the
                              safe-stop. Runs locally (on the Pi) by default; -H/--host
                              re-dispatches over ssh to a remote Pi.
  kill                        Stop and remove the sim + pico containers.
  -h, --help                  Show this help message.
EOF
}

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

cmd="$1"
shift

case "${cmd}" in
    sim)
        # Thin passthrough: scripts/sim.sh is the docker compose lifecycle
        # dispatcher (up / down / logs / build / shell / status / one-off cmd).
        exec "${REPO_ROOT}/scripts/sim.sh" "$@"
        ;;
    pico)
        # Firmware-in-sim, run as its own compose service. scripts/sim.sh owns
        # the pico verbs (up / down / logs / status) since it shares the image
        # and the compose helper.
        exec "${REPO_ROOT}/scripts/sim.sh" pico "$@"
        ;;
    deploy)
        exec "${REPO_ROOT}/scripts/deploy.sh" "$@"
        ;;
    robot)
        exec "${REPO_ROOT}/scripts/robot.sh" "$@"
        ;;
    kill)
        exec "${REPO_ROOT}/scripts/kill.sh" "$@"
        ;;
    -h|--help)
        usage
        ;;
    *)
        echo "Unknown command: ${cmd}" >&2
        usage
        exit 1
        ;;
esac
