<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexa_locomotion</name>
  <version>0.1.0</version>
  <description>
    Single-node locomotion controller: compiles shared/motion_core directly and
    runs the velocity -> gait -> posture -> IK pipeline in one 200 Hz tick.
    /cmd_vel and the discrete command topics in, joint commands out.
  </description>
  <maintainer email="olli.moisio@protonmail.com">Olli Moisio</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>hexa_interfaces</depend>

  <depend>yaml-cpp</depend>

  <!-- gen_config.py bakes its YAMLs at build time; the loader reads them at runtime. -->
  <build_depend>hexa_description</build_depend>
  <exec_depend>hexa_description</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
