<?xml version="1.0"?>
<package format="3">
  <name>hexa_teleop</name>
  <version>0.0.1</version>
  <description>Human-input nodes that produce body velocity (/cmd_vel) and body pose offsets (/body/pose) for the hexapod.</description>
  <maintainer email="olli.moisio@protonmail.com">Olli Moisio</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>hexa_interfaces</depend>
  <depend>hexa_common</depend>
  <!-- Runtime config-data reads, not code imports: teleop reads hexa_gait's
       gait.yaml (velocity caps) and hexa_posture's posture.yaml (animation-mode
       list). These drop away once that data moves to a neutral package
       (deferred with the gait migration). -->
  <exec_depend>hexa_gait</exec_depend>
  <exec_depend>hexa_posture</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
