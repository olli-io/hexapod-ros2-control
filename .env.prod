
# Host GID of the `input` group on the Pi. Use `getent group input | cut -d: -f3`
INPUT_GID=996

# DDS domain. Anything sharing this ID on the local network sees each other's
# topics;
ROS_DOMAIN_ID=42

# Path to the Servo 2040 inside /dev on the Pi.
SERVO_DEVICE=/dev/serial/by-id/usb-Raspberry_Pi_Pico_E6617C93E3965D28-if00
