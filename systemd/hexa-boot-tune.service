# Boot jingle on the passive buzzer (GPIO12 hardware PWM).
#
# Template: @HOME_DIR@ and @PWM_DEV@ are substituted by `./hexa robot
# install-tune`. Do not install this file by hand.
#
# Separate from hexa-robot.service because not every build has a buzzer fitted.
# Nothing depends on it, and the player exits 0 on every hardware failure, so a
# broken buzzer can never hold up a boot. This tune and hexa-shutdown-tune are
# host units only because no container is running that early or that late; the
# rest are hexa_buzzer's. See src/hexa_buzzer/README.md.

[Unit]
Description=Hexapod boot jingle (passive buzzer)
After=local-fs.target
ConditionPathIsDirectory=/sys/class/pwm

[Service]
Type=oneshot
# Root: exporting a sysfs PWM channel needs it.
User=root
# `python3 -m` puts the working directory on sys.path, which is how it finds
# the hexa_buzzer package deploy ships to @HOME_DIR@/hexa_buzzer/.
WorkingDirectory=@HOME_DIR@
# --wait 5: the only tune that can outrun the RP1 PWM driver's probe.
ExecStart=/usr/bin/python3 -m hexa_buzzer.player boot --pwm-dev @PWM_DEV@ --wait 5
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
