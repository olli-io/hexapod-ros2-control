# Watches the spool file the container asks for beeps with.
#
# Template — @HOME_DIR@ is substituted by `./hexa robot install-tune`, which
# writes the rendered unit to /etc/systemd/system/hexa-tune-spool.path and
# enables it. Do not install this file by hand; the placeholder is not a valid
# systemd value.
#
# Why a spool at all: the buzzer hangs off the Pi's hardware PWM, and the
# container cannot reach it. Docker mounts /sys read-only, and every
# /sys/class/pwm/pwmchipN is a symlink into /sys/devices, so an export from
# inside the container fails with EROFS however the class directory is bound.
# Reaching it would take a privileged container — far too much for a beep. So
# hexa_hardware writes a tune name into the log volume (already bind-mounted,
# so the host and the container share the inode) and this unit relays it out to
# the host's player.
#
# PathModified, not PathExists: PathExists stays satisfied for as long as the
# file is there, which would restart the service in a loop forever. PathModified
# fires per write and re-arms. If the file does not exist yet, systemd watches
# the closest existing parent directory and picks up its creation.

[Unit]
Description=Watch the hexapod buzzer spool for container-borne tune requests
ConditionPathIsDirectory=/sys/class/pwm
# Be watching before the stack can write. inotify only reports what happens
# while a watch is open, so a spool write that lands first is simply lost — and
# the `up` request lands within seconds of the container starting. In practice
# a .path unit is armed long before `hexa robot boot` has even found the Docker
# daemon, but ordering says so rather than assuming it. No-op if the stack's
# unit is not installed.
Before=hexa-robot.service

[Path]
PathModified=@HOME_DIR@/log/buzzer
Unit=hexa-tune-spool.service

[Install]
WantedBy=multi-user.target
