# Shutdown beep on the passive buzzer (GPIO12 hardware PWM), the mirror of
# hexa-boot-tune.service. When it stops sounding, the power switch is safe.
#
# Template: @HOME_DIR@ and @PWM_DEV@ are substituted by `./hexa robot
# install-tune`. Do not install this file by hand.
#
# DefaultDependencies=no keeps systemd from ordering this before the shutdown
# transaction; WantedBy/After=final.target puts it after every normal unit has
# stopped, hexa-robot.service included. That is why it cannot be hexa_buzzer's:
# there is no container left. The root filesystem is read-only by then, which
# costs nothing — the player only reads itself and writes sysfs.

[Unit]
Description=Hexapod shutdown beep (passive buzzer)
DefaultDependencies=no
After=final.target
ConditionPathIsDirectory=/sys/class/pwm

[Service]
Type=oneshot
User=root
# `python3 -m` puts the working directory on sys.path, which is how it finds
# the hexa_buzzer package deploy ships to @HOME_DIR@/hexa_buzzer/.
WorkingDirectory=@HOME_DIR@
# No --wait: the PWM tree has been up all session, and waiting here would only
# add dead time to a shutdown.
ExecStart=/usr/bin/python3 -m hexa_buzzer.player shutdown --pwm-dev @PWM_DEV@
# Hard ceiling on how long a buzzer can delay a power-off.
TimeoutStartSec=10

[Install]
WantedBy=final.target
