# Sample env file for `hexa deploy` on the robot.
# Copy to .env on the Pi (~/hexa-robot/.env) and edit as needed.

# Host GID of the `input` group on the Pi. Use `getent group input | cut -d: -f3`
INPUT_GID=996

# DDS domain. Anything sharing this ID on the local network sees each other's
# topics;
ROS_DOMAIN_ID=42

# Path to the Servo 2040 inside /dev on the Pi. /dev/ttyACM0 works for a
# single-board setup; switch to /dev/serial/by-id/usb-Pimoroni_Servo_2040-...
# once you know the stable string, so a re-enumerated bus number can't
# silently swap devices.
SERVO_DEVICE=/dev/ttyACM0

# SH1122 OLED face on the Pi SPI bus, rendered by hexa_display. The SPI and
# GPIO device nodes are mapped into the container; SPI_GID / GPIO_GID
# forward the Pi's `spi` / `gpio` group IDs so the node can open them
# (`getent group spi|gpio | cut -d: -f3`). Requires dtparam=spi=on; see
# docs/robot-environment.md. Omit these if no display is fitted (and set
# enabled: false in display.yaml).
SPI_DEVICE=/dev/spidev0.0
GPIO_CHIP=/dev/gpiochip0
SPI_GID=999
GPIO_GID=993
